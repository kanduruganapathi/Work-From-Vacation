# ── Shared environment (used by docker-compose) ──────────────────────────

# Anthropic API key powering the multi-agent AI layer.
ANTHROPIC_API_KEY=sk-ant-...

# Claude model for the agents. Defaults to the latest Opus.
AI_MODEL=claude-opus-4-8

# Database. SQLite for local dev; swap for Postgres in production:
#   DATABASE_URL=postgresql+psycopg://user:pass@db:5432/wfv
DATABASE_URL=sqlite:///./work_from_vacation.db

# JWT signing secret — generate a long random string for production.
SECRET_KEY=change-me-to-a-long-random-secret

# Optional: Adzuna full-time/contract aggregator (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Frontend → backend base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
