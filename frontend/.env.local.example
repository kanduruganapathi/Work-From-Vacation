# The Next.js server proxies /api/* to this backend origin (see next.config.js).
# The browser never sees this value — it only calls the frontend's own origin.
BACKEND_ORIGIN=http://localhost:8000

# Optional: make the browser call the backend directly instead of via the proxy.
# Leave unset to use the same-origin proxy (recommended; avoids CORS).
# NEXT_PUBLIC_API_BASE_URL=
