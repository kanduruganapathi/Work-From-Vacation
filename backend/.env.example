# Backend environment (copy to .env)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-4-8
DATABASE_URL=sqlite:///./work_from_vacation.db
SECRET_KEY=change-me-to-a-long-random-secret
# Default query/location for keyed aggregators
JOBS_DEFAULT_QUERY=software engineer
JOBS_DEFAULT_LOCATION=India

# Adzuna (free key at https://developer.adzuna.com/) — India by default
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Jooble (free key at https://jooble.org/api/about) — strong India coverage
JOOBLE_API_KEY=

# Careerjet (free affiliate id at https://www.careerjet.com/partners/)
CAREERJET_AFFID=
CAREERJET_LOCALE=en_IN

# Background scheduler: periodic refresh + AI auto-scoring + match alerts
SCHEDULER_ENABLED=false
SCHEDULER_REFRESH_MINUTES=60
ALERT_MATCH_THRESHOLD=75
AUTO_SCORE_LIMIT=10

# Optional SMTP for email alerts (in-app notifications work without this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
